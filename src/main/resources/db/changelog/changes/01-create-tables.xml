<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="create-tables" author="Siberia">
        <!-- Creator table -->
        <createTable tableName="tbl_creator" schemaName="distcomp">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="login" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="firstname" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="lastname" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Tweet table -->
        <createTable tableName="tbl_tweet" schemaName="distcomp">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="creator_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_tweet_creator" references="distcomp.tbl_creator(id)"/>
            </column>
            <column name="title" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="varchar(2048)"/>
            <column name="created" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modified" type="timestamp"/>
        </createTable>

        <!-- Marker table -->
        <createTable tableName="tbl_marker" schemaName="distcomp">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(32)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <!-- Notice table -->
        <createTable tableName="tbl_notice" schemaName="distcomp">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tweet_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_notice_tweet" references="distcomp.tbl_tweet(id)"/>
            </column>
            <column name="content" type="varchar(2048)"/>
        </createTable>

        <!-- TweetMarker join table for many-to-many relationship -->
        <createTable tableName="tbl_tweet_marker" schemaName="distcomp">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tweet_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_tweetmarker_tweet" references="distcomp.tbl_tweet(id)"/>
            </column>
            <column name="marker_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_tweetmarker_marker" references="distcomp.tbl_marker(id)"/>
            </column>
        </createTable>

        <addUniqueConstraint
                constraintName="uk_tweet_marker"
                tableName="tbl_tweet_marker"
                columnNames="tweet_id, marker_id"
                schemaName="distcomp"/>
    </changeSet>

</databaseChangeLog>