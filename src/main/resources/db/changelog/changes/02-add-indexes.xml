<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="add-indexes" author="Siberia">
        <!-- Indexes for Creator table -->
        <createIndex indexName="idx_creator_login" schemaName="distcomp" tableName="tbl_creator">
            <column name="login"/>
        </createIndex>

        <!-- Indexes for Tweet table -->
        <createIndex indexName="idx_tweet_creator_id" schemaName="distcomp" tableName="tbl_tweet">
            <column name="creator_id"/>
        </createIndex>
        <createIndex indexName="idx_tweet_created" schemaName="distcomp" tableName="tbl_tweet">
            <column name="created"/>
        </createIndex>
        <createIndex indexName="idx_tweet_title" schemaName="distcomp" tableName="tbl_tweet">
            <column name="title"/>
        </createIndex>

        <!-- Indexes for Marker table -->
        <createIndex indexName="idx_marker_name" schemaName="distcomp" tableName="tbl_marker">
            <column name="name"/>
        </createIndex>

        <!-- Indexes for Notice table -->
        <createIndex indexName="idx_notice_tweet_id" schemaName="distcomp" tableName="tbl_notice">
            <column name="tweet_id"/>
        </createIndex>

        <!-- Indexes for TweetMarker table -->
        <createIndex indexName="idx_tweetmarker_tweet_id" schemaName="distcomp" tableName="tbl_tweet_marker">
            <column name="tweet_id"/>
        </createIndex>
        <createIndex indexName="idx_tweetmarker_marker_id" schemaName="distcomp" tableName="tbl_tweet_marker">
            <column name="marker_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>